# Leave this unset (or copy this file to .env without uncommenting) to use
# the Vite dev proxy configured in vite.config.ts. By default it forwards
# /api requests to the local Docker backend at http://localhost:8080.
# VITE_API_BASE_URL=/api/v1

# To point the Vite proxy to a deployed backend instead, set this in .env.local.
# VITE_API_PROXY_TARGET=http://13.124.135.247:8080
