# Leave this unset (or copy this file to .env without uncommenting) to use
# the Vite dev proxy configured in vite.config.ts, which forwards /api to
# the real backend server-side and avoids CORS issues in local dev.
# VITE_API_BASE_URL=/api/v1

# Real backend (no CORS headers yet, so calling it directly from the
# browser will be blocked - only use this for a production build served
# from the same origin as the backend, or once CORS is fixed).
# VITE_API_BASE_URL=http://13.124.135.247:8080/api/v1
